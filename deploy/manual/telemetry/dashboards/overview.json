{
  "uid": "locker-overview",
  "title": "Locker overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "reservation",
        "label": "Reservation ID",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "skipUrlSync": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Gateway requests per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "locker-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "h": 7,
        "w": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (protocol) (rate(locker_gateway_requests_seconds_count[1m]))",
          "legendFormat": "{{protocol}}",
          "datasource": {
            "type": "prometheus",
            "uid": "locker-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Gateway errors per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "locker-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "h": 7,
        "w": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (protocol,outcome) (rate(locker_gateway_requests_seconds_count{outcome!=\"OK\"}[1m]))",
          "legendFormat": "{{protocol}} · {{outcome}}",
          "datasource": {
            "type": "prometheus",
            "uid": "locker-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Gateway p95 duration",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "locker-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "h": 7,
        "w": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by (le,protocol) (rate(locker_gateway_requests_seconds_bucket[2m])))",
          "legendFormat": "{{protocol}}",
          "datasource": {
            "type": "prometheus",
            "uid": "locker-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Outbox rows awaiting publication",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "locker-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 7,
        "h": 7,
        "w": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "locker_outbox_pending",
          "legendFormat": "pending",
          "datasource": {
            "type": "prometheus",
            "uid": "locker-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Unconsumed Kafka records",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "locker-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "h": 7,
        "w": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (consumergroup, topic) (clamp_min(kafka_consumergroup_lag{consumergroup=~\"locker-.*\"},0))",
          "legendFormat": "{{consumergroup}} · {{topic}}",
          "datasource": {
            "type": "prometheus",
            "uid": "locker-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Worker deliveries",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "locker-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "h": 7,
        "w": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (topic,outcome) (locker_worker_deliveries_total)",
          "legendFormat": "{{topic}} · {{outcome}}",
          "datasource": {
            "type": "prometheus",
            "uid": "locker-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Reservation events",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 21,
        "h": 12,
        "w": 24
      },
      "datasource": {
        "type": "loki",
        "uid": "locker-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"lockers\"} |= ${reservation:doublequote} | json",
          "queryType": "range",
          "datasource": {
            "type": "loki",
            "uid": "locker-loki"
          }
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 8,
      "title": "Circuit breaker state · 0 closed, 1 probing, 2 open",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "locker-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 33,
        "h": 7,
        "w": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by(service,dependency) (locker_rpc_breaker_state)",
          "legendFormat": "{{service}} → {{dependency}}",
          "datasource": {
            "type": "prometheus",
            "uid": "locker-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "Active outbound gRPC calls",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "locker-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 33,
        "h": 7,
        "w": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(service,dependency) (locker_rpc_inflight)",
          "legendFormat": "{{service}} → {{dependency}}",
          "datasource": {
            "type": "prometheus",
            "uid": "locker-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "title": "gRPC retries and refused calls",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "locker-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "h": 7,
        "w": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (__name__,service) ({__name__=~\"locker_rpc_(retries|rejected)_total\"})",
          "legendFormat": "{{service}} {{__name__}}",
          "datasource": {
            "type": "prometheus",
            "uid": "locker-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "title": "Caller quota fallback and rejections",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "locker-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "h": 7,
        "w": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(service,outcome) (locker_quota_events_total)",
          "legendFormat": "{{service}} {{outcome}}",
          "datasource": {
            "type": "prometheus",
            "uid": "locker-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      }
    }
  ]
}
